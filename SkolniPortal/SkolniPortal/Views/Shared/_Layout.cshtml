<!DOCTYPE html>
<html lang="en">



<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkolniPortal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SkolniPortal.styles.css" asp-append-version="true" />
</head>




<body>
    <header class="position-relative sticky-top" style="background-color: #223974;">
        <div class="position-absolute z-3" style="top: 10px; left: 15px;">
            <a asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/obrazky/SPS.png" alt="SPS Logo" height="45" />
            </a>
        </div>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark py-2">
            <div class="container-fluid d-flex justify-content-end">
                @{
                    var userId = Context.Session.GetInt32("UserId");
                    var userName = Context.Session.GetString("UserName");
                }
                <ul class="navbar-nav flex-row gap-2 align-items-center">
                    <li class="nav-item">
                        <a class="btn btn-header px-4 rounded-pill shadow-sm fw-bold" asp-area="" asp-controller="Zasedak" asp-action="Zasedak">Zasedací pořádky</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-header px-4 rounded-pill shadow-sm fw-bold"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="onas">
                            O nás
                        </a>
                    </li>

                    @if (userId != null)
                    {
                        <li class="nav-item ms-2">
                            <span class="text-white me-2">@userName</span>
                            <a class="btn btn-danger" asp-controller="User" asp-action="Logout">Odhlásit se</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-2">
                            <a class="btn btn-light text-dark" asp-controller="User" asp-action="Login">Přihlásit</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>




    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>




    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Školni Portal 
        </div>
    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
