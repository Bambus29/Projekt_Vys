@{
    ViewData["Title"] = "Register";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<div class="d-flex justify-content-center align-items-start" style="padding:40px 0;">
    <div class="card shadow-sm" style="width:100%;max-width:540px;">
        <div class="card-body">
            <h3 class="card-title mb-3 text-center">Registrace</h3>

            @if (ViewData["chyba"] != null) {
                <div class="alert alert-danger">@ViewData["chyba"]</div>
            }

            <form asp-controller="User" asp-action="Register" method="post" id="registerForm" novalidate>
                <div class="mb-3">
                    <label for="name" class="form-label">Login (bez čísla)</label>
                    <div class="input-group">
                        <input id="name" name="name" class="form-control" type="text"
                               placeholder="uživatelské jméno" required pattern="^[^0-9]+$"
                               title="Login nesmí obsahovat čísla." />
                        <span class="input-group-text">&#64;spstrutnov.cz</span>
                    </div>
                    <div class="form-text">Použij pouze písmena (bez čísel).</div>
                </div>

                <div class="row g-2">
                    <div class="col-md-6">
                        <label for="kasta" class="form-label">Číslo loginu (kasta)</label>
                        <input id="kasta" name="kasta" class="form-control" type="number" min="0" placeholder="např. 0 pro učitele" />
                    </div>
                    <div class="col-md-6">
                        <label for="trida" class="form-label">Třída</label>
                        <select id="trida" name="trida" class="form-select">
                            <option value="">Vyber třídu</option>
                            <optgroup label="EP">
                                <option>1.EP</option><option>2.EP</option><option>3.EP</option><option>4.EP</option>
                            </optgroup>
                            <optgroup label="IT">
                                <option>1.IT</option><option>2.IT</option><option>3.IT</option><option>4.IT</option>
                            </optgroup>
                            <optgroup label="S">
                                <option>1.S</option><option>2.S</option><option>3.S</option><option>4.S</option>
                            </optgroup>
                            <optgroup label="ST">
                                <option>1.ST</option><option>2.ST</option><option>3.ST</option><option>4.ST</option>
                            </optgroup>
                        </select>
                    </div>
                </div>

                <div class="mb-3 mt-3">
                    <label for="password" class="form-label">Heslo</label>
                    <input id="password" name="password" class="form-control" type="password" required minlength="3" />
                    <div class="form-text">Minimálně 3 znaky. Doporučeno kombinovat písmena a čísla.</div>
                </div>

                <div class="mb-3">
                    <label for="passwordcheck" class="form-label">Potvrzení hesla</label>
                    <input id="passwordcheck" name="passwordcheck" class="form-control" type="password" required />
                    <div id="passwordHelp" class="form-text text-danger d-none">Hesla se neshodují.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Síla hesla</label>
                    <div class="progress" style="height:8px;">
                        <div id="pwStrength" class="progress-bar" role="progressbar" style="width:0%"></div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-controller="User" asp-action="Login">Máte účet? Přihlaste se</a>
                    <button id="submitBtn" type="submit" class="btn btn-primary">Registrovat</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function(){
        const form = document.getElementById('registerForm');
        const pw = document.getElementById('password');
        const pwc = document.getElementById('passwordcheck');
        const pwHelp = document.getElementById('passwordHelp');
        const pwStrength = document.getElementById('pwStrength');

        function strengthScore(s) {
            let score = 0;
            if (!s) return 0;
            if (s.length >= 3) score += 25;
            if (/[0-9]/.test(s)) score += 25;
            if (/[a-z]/.test(s) && /[A-Z]/.test(s)) score += 25;
            if (/[^A-Za-z0-9]/.test(s)) score += 25;
            return Math.min(100, score);
        }

        function updateStrength() {
            const score = strengthScore(pw.value);
            pwStrength.style.width = score + '%';
            pwStrength.className = 'progress-bar';
            if (score < 35) pwStrength.classList.add('bg-danger');
            else if (score < 70) pwStrength.classList.add('bg-warning');
            else pwStrength.classList.add('bg-success');
        }

        pw.addEventListener('input', updateStrength);
        pwc.addEventListener('input', function(){
            const match = pw.value === pwc.value;
            pwHelp.classList.toggle('d-none', match);
        });

        form.addEventListener('submit', function(e){
            // native validity
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                e.preventDefault();
                e.stopPropagation();
                return;
            }
            if (pw.value !== pwc.value) {
                pwHelp.classList.remove('d-none');
                e.preventDefault();
                e.stopPropagation();
                return;
            }
        });
    })();
</script>
