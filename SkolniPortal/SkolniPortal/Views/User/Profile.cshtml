@model SkolniPortal.Models.User
@{
    ViewData["Title"] = "Profil";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="card-title">Profil uživatele</h2>
            <hr />
            <p><strong>Uživatelské jméno:</strong> @Model?.Name</p>
            <p><strong>Role:</strong> @Model?.Kasta</p>
            <p><strong>Třída:</strong> @Model?.Trida</p>

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Zpět na hlavní</a>
            </div>
        </div>
    </div>
</div>