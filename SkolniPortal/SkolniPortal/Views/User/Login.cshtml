@{
    ViewData["Title"] = "Login";
}
<div class="nastred card p-4 shadow-sm" style="max-width:420px;margin:30px auto;">
    <h2 class="mb-3">Přihlášení</h2>
    @if (ViewData["chyba"] != null)
    {
        <div class="alert alert-danger">@ViewData["chyba"]</div>
    }
    <form asp-controller="User" asp-action="Login" method="post">
        <div class="mb-3">
            <label class="form-label">Login (bez čísla)</label>
            <div class="input-group">
                <input class="form-control" type="text" name="name" placeholder="uživatelské jméno" />
                <span class="input-group-text">&#64;spstrutnov.cz</span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Heslo</label>
            <input class="form-control" type="password" name="password" />
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a asp-controller="User" asp-action="Register">Nemáš účet? Zaregistruj se</a>
            <button class="btn btn-primary" type="submit">Přihlásit</button>
        </div>
    </form>
</div>