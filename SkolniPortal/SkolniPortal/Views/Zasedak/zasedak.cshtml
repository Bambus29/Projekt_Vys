@{
    ViewData["Title"] = "Zasedací pořádky";
    var userId = Context.Session.GetInt32("UserId");
    var userName = Context.Session.GetString("UserName");
    var userKasta = Context.Session.GetString("UserKasta");
}

@if (userId == null)
{
    <div class="container mt-4">
        <div class="alert alert-warning" role="alert">
            <h4>Nejsi přihlášen/a!</h4>
            <p>Aby ses mohl/a podívat na zasedací pořádky, musíš se nejdříve přihlásit.</p>
            <a asp-controller="User" asp-action="Login" class="btn btn-primary">Přihlásit se</a>
        </div>
    </div>
}
else
{
    <div class="container mt-4 bg-white bg-opacity-75 p-5 rounded-3 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="display-4 fw-bold">Zasedací pořádky</h1>
            <small class="text-muted">Přihlášen/a jako: <strong>@userName</strong> (@userKasta)</small>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="row">
                @foreach (var zasedak in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title">@zasedak.forTrida</h5>
                                <p class="card-text">
                                    <strong>Počet míst:</strong> @zasedak.pocetMist<br>
                                   
                                </p>
                                <a href="@Url.Action("Edit", "Zasedak", new { id = zasedak.Id })" class="btn btn-sm btn-info">Zobrazit detail</a>
                                
                                @if (userKasta == "Učitel")
                                {
                                    <a href="@Url.Action("Edit", "Zasedak", new { id = zasedak.Id })" class="btn btn-sm btn-warning">Upravit</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <p>Zatím nejsou vytvořeny žádné zasedací pořádky.</p>
            </div>
        }

        @if (userKasta == "Učitel")
        {
            <hr class="my-5">
            <h3>Vytvořit nový zasedák</h3>
            <form asp-controller="Zasedak" asp-action="ZasedakView" method="post" class="mt-3">
                
                <button type="submit" class="btn btn-success">Vytvořit zasedák</button>
            </form>
        }
    </div>
    <img src="~/obrazky/zasedak.png" alt="Zasedací pořádek" class="img-fluid mt-4 rounded-3 shadow-sm">
}
